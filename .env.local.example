# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Real deployed origin — used to build email redirect links (invites, password resets)
NEXT_PUBLIC_SITE_URL=https://joncristfit.com

# Stripe (Developers > API keys) — use live mode keys
STRIPE_SECRET_KEY=your-stripe-secret-key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key

# Stripe webhook signing secret (created after first deploy, see Section 4c)
STRIPE_WEBHOOK_SECRET=your-webhook-signing-secret

# Already-live JCF Stripe prices — do not create new ones
STRIPE_PRICE_ID_PROGRAMMING=price_1TxIW3PdonTh59bbQ9yPQ3bW
STRIPE_PRICE_ID_COACHING=price_1TxIW7PdonTh59bb1xFMJyAs

# Push notifications (Web Push / VAPID) — generate a pair with
# `npx web-push generate-vapid-keys` and set the same values in Vercel.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
PUSH_CONTACT_EMAIL=mailto:you@example.com

# Shared secret protecting the inactivity-nudge cron endpoint. Vercel Cron
# sends this automatically as `Authorization: Bearer <value>` once the env
# var is set — generate any random string.
CRON_SECRET=your-random-secret

# SMTP for the app's own transactional emails (currently: the tier-based welcome
# email). Separate from Supabase's own SMTP config (used for invite/reset-password
# emails, set in the Supabase Dashboard) — same Google Workspace account works for
# both, but each needs its own credentials entered where it's used. For Gmail/Workspace,
# generate an App Password at https://myaccount.google.com/apppasswords (requires 2-Step
# Verification) — a regular account password will not work here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=jon@joncristfit.com
SMTP_PASS=your-app-password
EMAIL_FROM="Jon Crist Fit <jon@joncristfit.com>"
